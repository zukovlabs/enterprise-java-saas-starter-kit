# ==========================================
# Enterprise SaaS Starter - Configuration
# ==========================================

# 1. Application URL
APP_URL=http://localhost:8081

# 2. JWT Secret Key (min 32 bytes, base64-encoded)
JWT_SECRET=your_jwt_secret_here

# 3. Database password
DB_PASSWORD=your_db_password_here

# 4. CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081,http://localhost